<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY tarmoq sozlamasi. Android 9+ da HTTP (cleartext) sukut bo'yicha
  bloklanadi. Release APK bu faylni KO'RMAYDI (src/debug overlay) — prod
  build hamon HTTPS-only.

  Nega hammasiga ruxsat: v2m (3DGS) serveri Vast.ai instance'ida ishlaydi va
  uning IP:port'i har qayta ishga tushirishda o'zgaradi. Aniq manzillar
  ro'yxati har safar qo'lda yangilanishi kerak bo'lardi. v2m barqaror domen +
  TLS olgach (reja 2.7), bu faylni yana aniq ro'yxatga qaytarish kerak.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
