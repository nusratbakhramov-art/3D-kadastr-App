<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Backend API'ga ulanish uchun. Flutter buni faqat debug/profile
         manifestga avtomatik qo'shadi — release APK'da internet bo'lmasligi
         uchun shu yerda ham e'lon qilamiz. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Xaritada joriy joylashuvni aniqlash uchun (geolocator). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Push xabarnomalar (Android 13+ runtime ruxsat). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Video capture (VideoCaptureActivity) va 360° panorama capture
         (camera_android_camerax) — ikkalasi ham shu ruxsatga tayanadi. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- `camera_android_camerax` o'z manifestida RECORD_AUDIO so'raydi (u
         video yozuvni ham qo'llab-quvvatlaydi). Ilova esa MIKROFONNI
         ISHLATMAYDI: panorama capture faqat `takePicture()` chaqiradi, video
         yozuv esa :app ning o'z CameraX kodi orqali ovozsiz ketadi.
         Ruxsat qo'shilsa Play Console'da "Mikrofon" bo'lib ko'rinadi va
         data-safety deklaratsiyasida audio yig'ish savolini tug'diradi —
         yolg'on ruxsat. Shuning uchun merge paytida OLIB TASHLANADI. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />

    <!-- Kamera IXTIYORIY: kamerasiz qurilmada ham ilovaning qolgan qismi
         (e'lonlar, xarita, arizalar) to'liq ishlaydi. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- `camera_android_camerax` `camera.any` ni required="false" SIZ e'lon
         qiladi, ya'ni sukut bo'yicha MAJBURIY bo'lib qoladi va Play kamerasiz
         qurilmalarga ilovani umuman ko'rsatmaydi. `tools:replace` merge'da
         plagin qiymatini bizniki bilan almashtiradi (`tools:node="remove"`
         emas — feature'ning o'zi qolsin, faqat majburiyligi olinsin). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />

    <!-- Panorama capture kadr burchagini giroskop/akselerometrdan oladi
         (dchs_motion_sensors). Sensor yo'q qurilmada faqat SHU ekran
         ishlamaydi — ilovaning qolgani ishlaydi, demak majburiy emas.
         Ochiq e'lon qilmasak ham Play ularni filtr sifatida olmaydi, lekin
         ochiq required="false" niyatni qayd etadi va keyinchalik biror
         plagin required="true" bilan qo'shsa merge ziddiyati ko'rinadi. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Faqat telefonlar uchun: Google Play'da planshet, soat (Wear OS),
         Android TV va Chromebook'larni chiqarib tashlaymiz. Telefon "hardware"
         talab qilinishi shu qurilmalarni filtrlaydi. Ilova telefoniya API'sini
         ishlatmaydi — bu faqat Play distribution filtri uchun. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />
    <!-- Touchscreen talab qilinadi (TV/leanback qurilmalarni ham filtrlaydi). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:label="3D kadastr"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:preferMinimalPostProcessing="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- To'lovdan keyin /pay-return sahifasi `kadastr3d://pay-return/{id}`
                 custom scheme orqali ilovani qaytaradi (app_links ushlaydi). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="kadastr3d" android:host="pay-return"/>
            </intent-filter>
            <!-- Ulashilgan e'lon havolasi: `kadastr3d://market/{id}`. Host
                 alohida ko'rsatilishi shart — yuqoridagi filtr faqat
                 `pay-return` hostini ushlaydi. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="kadastr3d" android:host="market"/>
            </intent-filter>
        </activity>
        <!-- Debug-only video recorder (0.5x/0.6x + HD). Flutter'dagi tugma
             faqat kDebugMode'da ko'rinadi; exported EMAS. -->
        <activity
            android:name=".VideoCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Debug-only: tizim kamera ilovasi videoni shu papkaga yozadi
             (MainActivity.startSystemCamera). Authority image_picker'niki
             (${applicationId}.flutter.image_provider) bilan to'qnashmaydi. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.videocapture.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/video_capture_paths" />
        </provider>
        <!-- FCM: app fonда kelgan push qaysi kanalga tushishini belgilaydi
             (PushNotifications._channel bilan bir xil id). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Debug-only: qurilmaning kamera ilovasini topish uchun
             (MainActivity.startSystemCamera → grantUriPermission sikli). -->
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE"/>
        </intent>
        <!-- Bosh sahifadagi "qo'ng'iroq" tugmasi tel: orqali terish ilovasini
             ochishi uchun (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
