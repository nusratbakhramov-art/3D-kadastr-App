# Local-only development flags. Copy to `.env` and adjust.
# The real `.env` is gitignored — every machine (including the release build
# machine) needs its own copy, otherwise `flutter build` fails on the missing
# asset.
#
# admin=true unlocks developer-only shortcuts in debug builds, e.g. skipping
# the LiDAR scan in the AI Baholash wizard on a device without LiDAR.
# Leave it out (or set false) for production builds.
# admin=true
